# All optional. Copy to .env (or set in your hosting dashboard).

# Folder for the database, HTTP cache, fallback responses and image jobs.
CELESTRA_DATA_DIR=./backend

# Allowed browser origins for the API, comma-separated. Use your domain in production.
CELESTRA_CORS_ORIGINS=*

# Built website served by the API server (created by `npm run build`).
CELESTRA_FRONTEND_DIST=./frontend/dist

# Port for production / Docker.
PORT=8000

# Frontend only: set when the API runs on a different domain than the website.
# VITE_API_BASE=https://api.example.com
